{
	"expo": {
		"name": "soundretouched",
		"slug": "soundretouched",
		"scheme": "soundretouched",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"infoPlist": {
				"NSBonjourServices": ["_soundtouch._tcp"],
				"NSLocalNetworkUsageDescription": "Find and connect to SoundTouch speakers on your local network.",
				"NSAppTransportSecurity": {
					"NSAllowsLocalNetworking": true
				}
			},
			"bundleIdentifier": "com.remcos2000.soundretouched"
		},
		"android": {
			"package": "com.remcos2000.soundretouched",
			"permissions": [
				"android.permission.ACCESS_NETWORK_STATE",
				"android.permission.ACCESS_WIFI_STATE",
				"android.permission.CHANGE_WIFI_MULTICAST_STATE"
			],
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			}
		},
		"plugins": [
			"expo-router",
			"expo-font",
			"./plugins/withLocalNetwork.cjs",
			"expo-asset",
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-icon.png",
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			]
		]
	}
}
