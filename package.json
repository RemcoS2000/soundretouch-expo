{
	"name": "soundretouched",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "index.ts",
	"scripts": {
		"android": "expo run:android",
		"android:build": "bash scripts/build-android.sh",
		"android:emulator": "bash scripts/start-android-emulator.sh",
		"android:prebuild": "expo prebuild --platform android --no-install",
		"dependencies:check": "EXPO_OFFLINE=1 expo install --check",
		"doctor": "expo-doctor",
		"format": "prettier --write .",
		"ios": "expo run:ios",
		"lint": "eslint .",
		"prepare": "husky",
		"proxy": "tsx proxy/server.ts",
		"start": "expo start",
		"test": "npm run test:unit && npm run test:integration",
		"test:integration": "node --import tsx --test tests/*.test.ts",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"web": "expo start --web",
		"web:export": "expo export --platform web"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,yml,yaml,md}": [
			"prettier --write"
		]
	},
	"overrides": {
		"@istanbuljs/load-nyc-config": {
			"js-yaml": "^4.3.2"
		},
		"expo-modules-core": {
			"react-native-worklets": "0.13.0"
		},
		"xcode": {
			"uuid": "^11.1.1"
		}
	},
	"dependencies": {
		"@expo/vector-icons": "^15.1.1",
		"@material/material-color-utilities": "^0.4.0",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/slider": "5.2.1",
		"@soundretouch/api": "file:vendor/soundretouch-api-1.6.0.tgz",
		"@tanstack/react-query": "^5.104.3",
		"blurhash": "^2.0.5",
		"expo": "~58.0.11",
		"expo-asset": "~58.0.16",
		"expo-constants": "~58.0.12",
		"expo-dev-client": "~58.0.13",
		"expo-font": "~58.0.8",
		"expo-image": "~58.0.15",
		"expo-linear-gradient": "~58.0.3",
		"expo-linking": "~58.0.13",
		"expo-network": "~58.0.3",
		"expo-router": "~58.0.20",
		"expo-splash-screen": "~58.0.9",
		"expo-status-bar": "~58.0.3",
		"expo-system-ui": "~58.0.6",
		"fast-xml-parser": "^5.11.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-web": "~0.21.4",
		"react-native-zeroconf": "^0.17.6",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@playwright/test": "^1.64.1",
		"@react-native/babel-preset": "0.88.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tanstack/eslint-plugin-query": "^5.104.3",
		"@testing-library/react-native": "^14.1.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/express": "^5.0.6",
		"@types/react": "~19.3.0",
		"@types/ws": "^8.18.2",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitest/coverage-v8": "^5.0.5",
		"dependency-cruiser": "^18.6.0",
		"dotenv": "^18.0.8",
		"eslint": "^9.39.5",
		"eslint-config-expo": "~58.0.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsdoc": "^65.3.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-native": "^5.0.0",
		"eslint-plugin-sonarjs": "^4.2.2",
		"expo-doctor": "^1.21.4",
		"express": "^5.3.0",
		"husky": "^9.1.7",
		"jscpd": "^5.4.1",
		"knip": "^6.41.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-packagejson": "^3.0.2",
		"test-renderer": "^1.3.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"vitest-native": "^0.13.0"
	},
	"engines": {
		"node": ">=22.13 <23"
	}
}
