{
	"name": "SoundRetouched Dev",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:20",
	"postCreateCommand": "npm install",
	"mounts": ["source=node_modules_${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"],
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh"
			},
			"extensions": [
				"dbaeumer.vscode-eslint",
				"ms-vscode.vscode-typescript-next",
				"ReactNativeTools.vscode-react-native",
				"ms-azuretools.vscode-docker",
				"ms-vscode.remote-explorer",
				"github.vscode-github-actions",
				"prettier.prettier-vscode",
				"openai.chatgpt"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "20"
		}
	},
	"containerEnv": {
		"REACT_NATIVE_PACKAGER_HOSTNAME": "${localEnv:REACT_NATIVE_PACKAGER_HOSTNAME}"
	},
	"runArgs": ["--network=host", "--env-file", ".devcontainer/host.env", "--env-file", ".env"]
}
