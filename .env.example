# Optional Expo Web proxy; use .env.local for local overrides.
EXPO_PUBLIC_USE_DEV_PROXY=true
EXPO_PUBLIC_PROXY_BASE_URL=http://localhost
EXPO_PUBLIC_PROXY_PORT=4100

# Server settings (npm run proxy reads .env.local explicitly).
DEV_PROXY_PORT=4100
DEV_PROXY_DISCOVERY_TIMEOUT_MS=15000

# For LAN access from a phone, set REACT_NATIVE_PACKAGER_HOSTNAME only
# after verifying the reachable host address.
# Never put secrets in EXPO_PUBLIC_* variables.
